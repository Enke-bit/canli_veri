# ---------------------------------------------------------------------------
# MSSQL baglantisi
# ---------------------------------------------------------------------------
# Windows Authentication varsayilan ve onerilen yontemdir.
# SQL Server 2022 Express kuruluysa: .\SQLEXPRESS
# LocalDB kullaniyorsaniz: (localdb)\MSSQLLocalDB
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=DentSyncDemo
# Kurulu surucuyu yazin. Driver 18 kurulu degilse 17 kullanin.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=true
# Uretimde true olmalidir. Eski surucu + LocalDB "Encryption not supported"
# hatasi verirse YALNIZCA yerel gelistirmede false yapin.
DB_ENCRYPT=true
# Yerel gelistirmede self-signed sertifika icin true. URETIMDE false yapin.
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=10

# Sadece Windows Authentication KULLANMIYORSANIZ doldurun.
# Bu dosyaya gercek sifre yazmayin; .env dosyasini kullanin.
# DB_USERNAME=
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# API ve senkronizasyon
# ---------------------------------------------------------------------------
SOURCE_API_URL=http://127.0.0.1:8001
SOURCE_DATA_FILE=data/synthetic_source.json

SYNC_PAGE_SIZE=200
# Zaman damgasi sinirinda kayit kaybolmamasi icin geriye dogru ortusme penceresi.
SYNC_OVERLAP_SECONDS=120
SYNC_LOCK_STALE_SECONDS=3600

HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_SECONDS=1.0

# Uygulama log seviyesi: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Dashboard (http://127.0.0.1:8000/dashboard)
# ---------------------------------------------------------------------------
# Tarayicidan senkronizasyon baslatmayi acar/kapatir.
# Yalnizca yerel demo icin; internete acik ortamda false yapin.
ENABLE_SYNC_TRIGGER=true
# Dashboard'in veri cekmesine izin verilen kaynaklar (virgulle ayrilir).
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
